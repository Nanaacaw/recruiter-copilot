AI_PROVIDER=openai

# Recommended: OpenAI-compatible Ollama gateway
OPENAI_API_KEY=your_ollama_gateway_key_here
OPENAI_BASE_URL=https://ollama.nayerim.my.id/v1
# qwen2.5:7b is the safer default for fewer timeouts; switch to qwen2.5:14b when the gateway has capacity.
OPENAI_MODEL=qwen2.5:7b

# Gemini backup
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-haiku-20240307

# Native Ollama API fallback, if your gateway exposes /api/generate
OLLAMA_BASE_URL=https://ollama.nayerim.my.id
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_API_KEY=your_ollama_gateway_key_here

# Rate-limit protection
AI_MAX_RETRIES=3
AI_RETRY_BASE_DELAY_SECONDS=2
AI_SCREENING_DELAY_SECONDS=1
AI_REQUEST_TIMEOUT_SECONDS=180
