AI_PROVIDER=gemini

# OpenAI-compatible endpoint (OpenRouter / Ollama gateway)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Gemini (recommended — better rate limits)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.0-flash

# Claude (optional)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-haiku-20240307

# Native Ollama (if not using OpenAI compatibility)
OLLAMA_BASE_URL=https://ollama.example.com
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_API_KEY=

# AI tuning
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_SECONDS=3
AI_SCREENING_DELAY_SECONDS=2
AI_REQUEST_TIMEOUT_SECONDS=300
AI_SCREENING_MAX_CV_CHARS=12000
AI_SCREENING_MAX_JD_CHARS=5000
OPENAI_SCREENING_MAX_TOKENS=0

# App auth — CHANGE THESE before going live
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=change-this-strong-password
AUTH_SECRET_KEY=change-this-to-a-random-32-char-string-minimum
AUTH_TOKEN_EXPIRE_MINUTES=720
AUTH_PUBLIC_PATH_PREFIXES=["/api/auth","/api/health"]

# Security
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_WINDOW_SECONDS=60
SECURITY_RATE_LIMIT_MAX_REQUESTS=20
SECURITY_PROTECTED_PATH_PREFIXES=["/api/auth/login","/api/candidates/upload","/api/screening","/api/export"]
SECURITY_RATE_LIMIT_METHODS=["POST","PUT","PATCH","DELETE"]

# CORS — add your public frontend URL
CORS_ORIGINS=["http://localhost:3000","https://app.yourdomain.com"]

# PostgreSQL — set DB_USER and DB_PASSWORD in your root .env (docker-compose)
# DATABASE_URL is injected automatically by docker-compose via environment block.
# Only set this manually if running without Docker:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_screening

# Production mode: set to false to hide Swagger UI
DEBUG=false
