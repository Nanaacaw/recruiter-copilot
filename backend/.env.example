AI_PROVIDER=openai

# Recommended: OpenAI-compatible Ollama gateway
OPENAI_API_KEY=your_ollama_gateway_key_here
OPENAI_BASE_URL=https://ollama.nayerim.my.id/v1
# qwen2.5:7b is the safer default for fewer timeouts; switch to qwen2.5:14b when the gateway has capacity.
OPENAI_MODEL=qwen2.5:7b

# Gemini backup
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-haiku-20240307

# Native Ollama API fallback, if your gateway exposes /api/generate
OLLAMA_BASE_URL=https://ollama.nayerim.my.id
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_API_KEY=your_ollama_gateway_key_here

# Rate-limit protection
AI_MAX_RETRIES=3
AI_RETRY_BASE_DELAY_SECONDS=2
AI_SCREENING_DELAY_SECONDS=1
AI_REQUEST_TIMEOUT_SECONDS=180
AI_SCREENING_MAX_CV_CHARS=12000
AI_SCREENING_MAX_JD_CHARS=5000
OPENAI_SCREENING_MAX_TOKENS=900

# Allow the public frontend hostname to call the API over CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://app.nanacaw.my.id"]

# Basic anti-spam protection (per-IP in-memory rate limit for sensitive endpoints)
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_WINDOW_SECONDS=60
SECURITY_RATE_LIMIT_MAX_REQUESTS=20
SECURITY_PROTECTED_PATH_PREFIXES=["/api/candidates/upload","/api/screening","/api/export"]
SECURITY_RATE_LIMIT_METHODS=["POST","PUT","PATCH","DELETE"]
